{
  "manifest_version": 3,
  "name": "Google Search Region Switcher (gl)",
  "version": "1.0.0",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "*://www.google.com/search*"
  ],
  "action": {
    "default_title": "Switch Google Search region (gl)"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "options_page": "options.html"
}
